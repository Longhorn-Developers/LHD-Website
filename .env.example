# API Key for client and server access
NEXT_PUBLIC_API_KEY=http://localhost:3000

# Database connection
DATABASE_URL=postgresql://localhost:5432/dbname

# JWT authentication secret
JWT_SECRET=your_generated_secret_here

# Application environment
NODE_ENV=development

# Setup Instructions:
# 1. Configure a local PostgreSQL database if needed.
#    Create a database named admindb and a table named users.
#    Alternatively, use the default development credentials in api/auth/login.
#
# 2. Generate a secure JWT secret by running:
#    openssl rand -base64 64
#    Add the generated value to your .env.local file.
#
# 3. Set NODE_ENV to development for local development
#    and production when deploying.
