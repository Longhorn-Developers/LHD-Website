# API Key for client and server access
NEXT_PUBLIC_API_KEY=http://localhost:3000

# Application URL (used for password reset links and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database connection
DATABASE_URL=postgresql://localhost:5432/admindb

# JWT authentication secret
JWT_SECRET=your_generated_secret_here

# Email configuration (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_google_app_password

# Application environment
NODE_ENV=development

# Setup Instructions:
# 1. Configure a local PostgreSQL database if needed.
#    Create a database named admindb and a table named users.
#
# 2. Generate a secure JWT secret by running:
#    openssl rand -base64 64
#    Add the generated value to your .env.local file.
#
# 3. Configure Gmail SMTP:
#    EMAIL_USER should be your Gmail address.
#    EMAIL_PASS should be a Google App Password, NOT your
#    regular Google account password.
#    Generate one at https://myaccount.google.com/apppasswords
#
# 4. Set NEXT_PUBLIC_APP_URL to your application's base URL.
#    Development: http://localhost:3000
#    Production: https://your-domain.com
#
# 5. Set NODE_ENV to development locally
#    and production when deploying.